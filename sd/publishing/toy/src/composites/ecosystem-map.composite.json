{
  "manifest": {
    "id": "ecosystem-map",
    "name": "Ecosystem Map",
    "category": "service-design",
    "description": "The service's ecosystem: actors in rings by tier around the core service, value flowing between them by kind, the channels, the moments of truth, and the failure register.",
    "keywords": [
      "ecosystem",
      "service design",
      "value exchange",
      "actors",
      "failure modes"
    ],
    "cognitiveLoad": 8,
    "solves": "Seeing who the service depends on, what moves between them, and where it breaks",
    "appliesWhen": [
      "a legion ecosystem document is published"
    ],
    "usagePatterns": {
      "do": [
        "Colour flows by kind in a fixed order, with a legend that shows absent kinds as zero",
        "Keep the failure register beside the map, not in an appendix"
      ],
      "never": [
        "Place an actor in a ring its tier does not name",
        "Draw a flow whose endpoint is not an actor without saying so"
      ]
    }
  },
  "input": [
    "ecosystem"
  ],
  "output": [],
