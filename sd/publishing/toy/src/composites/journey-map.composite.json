{
  "manifest": {
    "id": "journey-map",
    "name": "Journey Map",
    "category": "service-design",
    "description": "One persona through one scenario: phases left to right, the emotion curve across them, and lanes for doing, thinking, feeling, touchpoints, pains and opportunities.",
    "keywords": [
      "journey",
      "service design",
      "emotion curve",
      "phases"
    ],
    "cognitiveLoad": 7,
    "solves": "Seeing where a scenario hurts and why, phase by phase",
    "appliesWhen": [
      "a legion journey document is published"
    ],
    "usagePatterns": {
      "do": [
        "Draw the curve from the phase scores, never from the ASCII curve string",
        "Keep every lane in phase order so columns line up"
      ],
      "never": [
        "Invent an emotion for an empty cell",
        "Reorder phases"
      ]
    }
  },
  "input": [
    "journey"
  ],
  "output": [],
  "blocks": [
    {
      "id": "page",
      "type": "container",
      "meta": {
        "as": "div",
        "size": "full",
        "padding": "8",
        "gap": "8"
      },
      "children": [
        "head",
        "curve-sec",
        "grid-sec",
        "mot",
        "crit",
        "open"
      ]
    },
    {
      "id": "head",
      "type": "container",
      "parentId": "page",
      "meta": {
        "as": "header",
        "gap": "4"
      },
      "children": [
        "kicker",
        "title",
        "metarow",
        "scenario",
        "goal"
      ]
    },
    {
