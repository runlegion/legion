{
  "manifest": {
    "id": "service-blueprint",
    "name": "Service Blueprint",
    "category": "service-design",
    "description": "The frontstage and backstage of a service across its steps: evidence, one lane per actor, frontstage, backstage and support, separated by the lines of interaction, visibility and internal interaction; moments of truth marked; frictions and fail points pinned to their steps.",
    "keywords": ["blueprint", "service design", "frontstage", "backstage", "fail points"],
    "cognitiveLoad": 8,
    "solves": "Seeing what has to happen behind each step of a journey, and where it breaks",
    "appliesWhen": ["a legion blueprint document is published"],
    "usagePatterns": {
      "do": ["Keep steps in order left to right", "Name planned machinery as planned"],
      "never": ["Draw a planned system as running", "Hide an empty layer cell: an empty cell is a finding"]
    }
  },
  "input": ["blueprint"],
  "output": [],
  "blocks": [
    { "id": "page", "type": "container", "meta": { "as": "div", "size": "full", "padding": "8", "gap": "8" }, "children": ["head", "grid-sec", "mot", "metrics", "links"] },

    { "id": "head", "type": "container", "parentId": "page", "meta": { "as": "header", "gap": "4" }, "children": ["kicker", "title", "metarow", "trigger", "scope", "actors", "channels"] },
    { "id": "kicker", "type": "muted", "parentId": "head", "content": "Service blueprint" },
    { "id": "title", "type": "h1", "parentId": "head", "content": { "$bind": "props.meta.title" } },
    { "id": "metarow", "type": "p", "parentId": "head", "children": ["m-st", "m-s1", "m-steps", "m-s2", "m-d"] },
    { "id": "m-st", "type": "badge", "parentId": "metarow", "meta": { "variant": "muted" }, "content": { "$bind": "props.meta.status" } },
    { "id": "m-s1", "type": "text", "parentId": "metarow", "content": " " },
    { "id": "m-steps", "type": "badge", "parentId": "metarow", "meta": { "variant": "outline" }, "content": { "$bind": "props.steps", "$count": true } },
    { "id": "m-s2", "type": "text", "parentId": "metarow", "content": " steps " },
    { "id": "m-d", "type": "badge", "parentId": "metarow", "meta": { "variant": "outline" }, "content": { "$bind": "props.meta.date" } },
    { "id": "trigger", "type": "p", "parentId": "head", "content": "Trigger: ", "children": ["trigger-t"] },
    { "id": "trigger-t", "type": "citation-text", "parentId": "trigger", "meta": { "text": { "$bind": "props.meta.trigger" } } },
    { "id": "scope", "type": "muted", "parentId": "head", "content": { "$bind": "props.meta.scope" } },
    { "id": "actors", "type": "p", "parentId": "head", "content": "Actors: ", "children": ["actor-rep"] },
    { "id": "actor-rep", "type": "repeat", "parentId": "actors", "meta": { "each": { "$bind": "props.actors" }, "as": "a" }, "children": ["actor-badge", "actor-sp"] },
    { "id": "actor-badge", "type": "badge", "parentId": "actor-rep", "meta": { "variant": { "$bind": "a.role", "$map": { "customer": "info", "on_stage": "secondary" } } }, "content": { "$tpl": "{a.name} ({a.role})" } },
    { "id": "actor-sp", "type": "text", "parentId": "actor-rep", "content": " " },
    { "id": "channels", "type": "p", "parentId": "head", "content": "Channels: ", "children": ["ch-rep"] },
    { "id": "ch-rep", "type": "repeat", "parentId": "channels", "meta": { "each": { "$bind": "props.meta.channels" }, "as": "ch" }, "children": ["ch-badge", "ch-sp"] },
    { "id": "ch-badge", "type": "badge", "parentId": "ch-rep", "meta": { "variant": "outline" }, "content": { "$bind": "ch" } },
    { "id": "ch-sp", "type": "text", "parentId": "ch-rep", "content": " " },

    { "id": "grid-sec", "type": "container", "parentId": "page", "meta": { "as": "section", "gap": "4" }, "children": ["grid-h", "grid"] },
    { "id": "grid-h", "type": "h2", "parentId": "grid-sec", "content": "The blueprint" },
    { "id": "grid", "type": "blueprint-grid", "parentId": "grid-sec", "meta": { "blueprint": { "$bind": "props" } } },

    { "id": "mot", "type": "container", "parentId": "page", "meta": { "as": "section", "gap": "4" }, "children": ["mot-h", "mot-rep"] },
    { "id": "mot-h", "type": "h2", "parentId": "mot", "content": "Moments of truth" },
    { "id": "mot-rep", "type": "repeat", "parentId": "mot", "meta": { "each": { "$bind": "props.moments_of_truth" }, "as": "m" }, "children": ["mot-card"] },
    { "id": "mot-card", "type": "card", "parentId": "mot-rep", "children": ["mot-ch", "mot-cc", "mot-cf"] },
    { "id": "mot-ch", "type": "card-header", "parentId": "mot-card", "children": ["mot-t", "mot-step"] },
    { "id": "mot-t", "type": "card-title", "parentId": "mot-ch", "content": { "$bind": "m.title" } },
    { "id": "mot-step", "type": "card-description", "parentId": "mot-ch", "content": { "$tpl": "Step {m.step}" } },
    { "id": "mot-cc", "type": "card-content", "parentId": "mot-card", "children": ["mot-grid"] },
    { "id": "mot-grid", "type": "grid", "parentId": "mot-cc", "meta": { "preset": "linear", "columns": 2, "gap": "4" }, "children": ["mot-ok", "mot-fail"] },
    { "id": "mot-ok", "type": "alert", "parentId": "mot-grid", "meta": { "variant": "success" }, "children": ["mot-ok-t", "mot-ok-d"] },
    { "id": "mot-ok-t", "type": "alert-title", "parentId": "mot-ok", "content": "Success" },
    { "id": "mot-ok-d", "type": "alert-description", "parentId": "mot-ok", "children": ["mot-ok-x"] },
    { "id": "mot-ok-x", "type": "citation-text", "parentId": "mot-ok-d", "meta": { "text": { "$bind": "m.success" } } },
    { "id": "mot-fail", "type": "alert", "parentId": "mot-grid", "meta": { "variant": "destructive" }, "children": ["mot-fail-t", "mot-fail-d"] },
    { "id": "mot-fail-t", "type": "alert-title", "parentId": "mot-fail", "content": "Failure" },
    { "id": "mot-fail-d", "type": "alert-description", "parentId": "mot-fail", "children": ["mot-fail-x"] },
    { "id": "mot-fail-x", "type": "citation-text", "parentId": "mot-fail-d", "meta": { "text": { "$bind": "m.failure" } } },
    { "id": "mot-cf", "type": "card-footer", "parentId": "mot-card", "children": ["mot-ev"] },
    { "id": "mot-ev", "type": "small", "parentId": "mot-cf", "content": "Evidence: ", "children": ["mot-chips"] },
    { "id": "mot-chips", "type": "citation-chips", "parentId": "mot-ev", "meta": { "ids": { "$bind": "m.evidence" } } },

    { "id": "metrics", "type": "container", "parentId": "page", "meta": { "as": "section", "gap": "4" }, "children": ["met-h", "met-table"] },
    { "id": "met-h", "type": "h2", "parentId": "metrics", "content": "Metrics by step" },
    { "id": "met-table", "type": "table", "parentId": "metrics", "children": ["met-head", "met-body"] },
    { "id": "met-head", "type": "table-header", "parentId": "met-table", "children": ["met-hr"] },
    { "id": "met-hr", "type": "table-row", "parentId": "met-head", "children": ["met-h1", "met-h2"] },
    { "id": "met-h1", "type": "table-head", "parentId": "met-hr", "content": "Step" },
    { "id": "met-h2", "type": "table-head", "parentId": "met-hr", "content": "Metric" },
    { "id": "met-body", "type": "table-body", "parentId": "met-table", "children": ["met-steps"] },
    { "id": "met-steps", "type": "repeat", "parentId": "met-body", "meta": { "each": { "$bind": "props.steps" }, "as": "s" }, "children": ["met-rep"] },
    { "id": "met-rep", "type": "repeat", "parentId": "met-steps", "meta": { "each": { "$bind": "s.metrics" }, "as": "mt" }, "children": ["met-row"] },
    { "id": "met-row", "type": "table-row", "parentId": "met-rep", "children": ["met-c1", "met-c2"] },
    { "id": "met-c1", "type": "table-cell", "parentId": "met-row", "content": { "$tpl": "{s.number}. {s.title}" } },
    { "id": "met-c2", "type": "table-cell", "parentId": "met-row", "children": ["met-t"] },
    { "id": "met-t", "type": "citation-text", "parentId": "met-c2", "meta": { "text": { "$bind": "mt" } } },

    { "id": "links", "type": "container", "parentId": "page", "meta": { "as": "section", "gap": "4" }, "children": ["ln-h", "ln-table"] },
    { "id": "ln-h", "type": "h2", "parentId": "links", "content": "Evidence by step" },
    { "id": "ln-table", "type": "table", "parentId": "links", "children": ["ln-head", "ln-body"] },
    { "id": "ln-head", "type": "table-header", "parentId": "ln-table", "children": ["ln-hr"] },
    { "id": "ln-hr", "type": "table-row", "parentId": "ln-head", "children": ["ln-h1", "ln-h2", "ln-h3"] },
    { "id": "ln-h1", "type": "table-head", "parentId": "ln-hr", "content": "Step" },
    { "id": "ln-h2", "type": "table-head", "parentId": "ln-hr", "content": "Words" },
    { "id": "ln-h3", "type": "table-head", "parentId": "ln-hr", "content": "Source" },
    { "id": "ln-body", "type": "table-body", "parentId": "ln-table", "children": ["ln-steps"] },
    { "id": "ln-steps", "type": "repeat", "parentId": "ln-body", "meta": { "each": { "$bind": "props.steps" }, "as": "s" }, "children": ["ln-rep"] },
    { "id": "ln-rep", "type": "repeat", "parentId": "ln-steps", "meta": { "each": { "$bind": "s.evidence_links" }, "as": "e" }, "children": ["ln-row"] },
    { "id": "ln-row", "type": "table-row", "parentId": "ln-rep", "children": ["ln-c1", "ln-c2", "ln-c3"] },
    { "id": "ln-c1", "type": "table-cell", "parentId": "ln-row", "content": { "$bind": "s.number" } },
    { "id": "ln-c2", "type": "table-cell", "parentId": "ln-row", "content": { "$bind": "e.text" } },
    { "id": "ln-c3", "type": "table-cell", "parentId": "ln-row", "children": ["ln-link"] },
    { "id": "ln-link", "type": "link", "parentId": "ln-c3", "meta": { "href": { "$bind": "e.url" } }, "content": { "$bind": "e.source" } }
  ]
}
