{
  "manifest": {
    "id": "persona-card",
    "name": "Persona Card",
    "category": "service-design",
    "description": "A behaviour-based persona: identity and quote, goals, frustrations, needs, the moment of truth, what would make them leave, and the relationship stages; open items shown, not hidden.",
    "keywords": ["persona", "service design", "behaviour", "moment of truth"],
    "cognitiveLoad": 6,
    "solves": "Holding one synthetic person in mind, with every line one step from its evidence",
    "appliesWhen": ["a legion persona document is published"],
    "usagePatterns": {
      "do": ["Put the quote and mental model before goals", "Show open questions as open, in the card"],
      "never": ["Add a photo, age or demographic the document does not carry", "Drop citation ids from any line"]
    }
  },
  "input": ["persona"],
  "output": [],
  "blocks": [
    { "id": "page", "type": "container", "meta": { "as": "div", "size": "6xl", "padding": "8", "gap": "8" }, "children": ["head", "identity", "lists", "mot", "stages", "quotes", "open"] },

    { "id": "head", "type": "container", "parentId": "page", "meta": { "as": "header", "gap": "4" }, "children": ["kicker", "title", "metarow"] },
    { "id": "kicker", "type": "muted", "parentId": "head", "content": "Persona" },
    { "id": "title", "type": "h1", "parentId": "head", "content": { "$bind": "props.meta.title" } },
    { "id": "metarow", "type": "p", "parentId": "head", "children": ["m-group", "m-s1", "m-stories", "m-s2", "m-authors", "m-s3", "m-status"] },
    { "id": "m-group", "type": "badge", "parentId": "metarow", "meta": { "variant": "secondary" }, "content": { "$tpl": "group {props.built_from.group}" } },
    { "id": "m-s1", "type": "text", "parentId": "metarow", "content": " " },
    { "id": "m-stories", "type": "badge", "parentId": "metarow", "meta": { "variant": "outline" }, "content": { "$tpl": "{props.built_from.stories} stories" } },
    { "id": "m-s2", "type": "text", "parentId": "metarow", "content": " " },
    { "id": "m-authors", "type": "badge", "parentId": "metarow", "meta": { "variant": "outline" }, "content": { "$tpl": "{props.built_from.authors} authors" } },
    { "id": "m-s3", "type": "text", "parentId": "metarow", "content": " " },
    { "id": "m-status", "type": "badge", "parentId": "metarow", "meta": { "variant": "muted" }, "content": { "$bind": "props.meta.status" } },

    { "id": "identity", "type": "grid", "parentId": "page", "meta": { "preset": "golden", "gap": "6" }, "children": ["id-main", "id-side"] },
    { "id": "id-main", "type": "grid-item", "parentId": "identity", "meta": { "priority": "primary" }, "children": ["quote", "desc"] },
    { "id": "quote", "type": "blockquote", "parentId": "id-main", "children": ["quote-text"] },
    { "id": "quote-text", "type": "citation-text", "parentId": "quote", "meta": { "text": { "$bind": "props.identity.quote" } } },
    { "id": "desc", "type": "p", "parentId": "id-main", "children": ["desc-text"] },
    { "id": "desc-text", "type": "citation-text", "parentId": "desc", "meta": { "text": { "$bind": "props.identity.description" } } },
    { "id": "id-side", "type": "card", "parentId": "identity", "children": ["mm-h", "mm-c"] },
    { "id": "mm-h", "type": "card-header", "parentId": "id-side", "children": ["mm-t"] },
    { "id": "mm-t", "type": "card-title", "parentId": "mm-h", "content": "How they think it works" },
    { "id": "mm-c", "type": "card-content", "parentId": "id-side", "children": ["mm-text", "cm-h", "cm-text"] },
    { "id": "mm-text", "type": "citation-text", "parentId": "mm-c", "meta": { "text": { "$bind": "props.identity.mental_model" } } },
    { "id": "cm-h", "type": "h4", "parentId": "mm-c", "content": "Changed their mind" },
    { "id": "cm-text", "type": "citation-text", "parentId": "mm-c", "meta": { "text": { "$bind": "props.changed_their_mind" } } },

    { "id": "lists", "type": "grid", "parentId": "page", "meta": { "preset": "linear", "columns": 2, "gap": "4" }, "children": ["goals", "frus", "needs", "behav"] },

    { "id": "goals", "type": "card", "parentId": "lists", "children": ["goals-h", "goals-c"] },
    { "id": "goals-h", "type": "card-header", "parentId": "goals", "children": ["goals-t"] },
    { "id": "goals-t", "type": "card-title", "parentId": "goals-h", "content": "Goals" },
    { "id": "goals-c", "type": "card-content", "parentId": "goals", "children": ["goals-ul"] },
    { "id": "goals-ul", "type": "ul", "parentId": "goals-c", "children": ["goals-rep"] },
    { "id": "goals-rep", "type": "repeat", "parentId": "goals-ul", "meta": { "each": { "$bind": "props.goals" }, "as": "g" }, "children": ["goals-li"] },
    { "id": "goals-li", "type": "li", "parentId": "goals-rep", "children": ["goals-text"] },
    { "id": "goals-text", "type": "citation-text", "parentId": "goals-li", "meta": { "text": { "$bind": "g" } } },

    { "id": "frus", "type": "card", "parentId": "lists", "children": ["frus-h", "frus-c"] },
    { "id": "frus-h", "type": "card-header", "parentId": "frus", "children": ["frus-t"] },
    { "id": "frus-t", "type": "card-title", "parentId": "frus-h", "content": "Frustrations" },
    { "id": "frus-c", "type": "card-content", "parentId": "frus", "children": ["frus-ul"] },
    { "id": "frus-ul", "type": "ul", "parentId": "frus-c", "children": ["frus-rep"] },
    { "id": "frus-rep", "type": "repeat", "parentId": "frus-ul", "meta": { "each": { "$bind": "props.frustrations" }, "as": "f" }, "children": ["frus-li"] },
    { "id": "frus-li", "type": "li", "parentId": "frus-rep", "children": ["frus-text"] },
    { "id": "frus-text", "type": "citation-text", "parentId": "frus-li", "meta": { "text": { "$bind": "f.text" } } },

    { "id": "needs", "type": "card", "parentId": "lists", "children": ["needs-h", "needs-c"] },
    { "id": "needs-h", "type": "card-header", "parentId": "needs", "children": ["needs-t"] },
    { "id": "needs-t", "type": "card-title", "parentId": "needs-h", "content": "Needs" },
    { "id": "needs-c", "type": "card-content", "parentId": "needs", "children": ["needs-ul"] },
    { "id": "needs-ul", "type": "ul", "parentId": "needs-c", "children": ["needs-rep"] },
    { "id": "needs-rep", "type": "repeat", "parentId": "needs-ul", "meta": { "each": { "$bind": "props.needs" }, "as": "n" }, "children": ["needs-li"] },
    { "id": "needs-li", "type": "li", "parentId": "needs-rep", "children": ["needs-text"] },
    { "id": "needs-text", "type": "citation-text", "parentId": "needs-li", "meta": { "text": { "$bind": "n" } } },

    { "id": "behav", "type": "card", "parentId": "lists", "children": ["behav-h", "behav-c"] },
    { "id": "behav-h", "type": "card-header", "parentId": "behav", "children": ["behav-t"] },
    { "id": "behav-t", "type": "card-title", "parentId": "behav-h", "content": "What they do" },
    { "id": "behav-c", "type": "card-content", "parentId": "behav", "children": ["behav-ul"] },
    { "id": "behav-ul", "type": "ul", "parentId": "behav-c", "children": ["behav-rep"] },
    { "id": "behav-rep", "type": "repeat", "parentId": "behav-ul", "meta": { "each": { "$bind": "props.behaviors" }, "as": "b" }, "children": ["behav-li"] },
    { "id": "behav-li", "type": "li", "parentId": "behav-rep", "children": ["behav-text"] },
    { "id": "behav-text", "type": "citation-text", "parentId": "behav-li", "meta": { "text": { "$bind": "b.text" } } },

    { "id": "mot", "type": "container", "parentId": "page", "meta": { "as": "section", "gap": "4" }, "children": ["mot-h", "mot-desc", "mot-grid"] },
    { "id": "mot-h", "type": "h2", "parentId": "mot", "content": "Moment of truth" },
    { "id": "mot-desc", "type": "lead", "parentId": "mot", "children": ["mot-desc-text"] },
    { "id": "mot-desc-text", "type": "citation-text", "parentId": "mot-desc", "meta": { "text": { "$bind": "props.moment_of_truth.description" } } },
    { "id": "mot-grid", "type": "grid", "parentId": "mot", "meta": { "preset": "linear", "columns": 3, "gap": "4" }, "children": ["mot-ok", "mot-fail", "leave"] },
    { "id": "mot-ok", "type": "alert", "parentId": "mot-grid", "meta": { "variant": "success" }, "children": ["mot-ok-t", "mot-ok-d"] },
    { "id": "mot-ok-t", "type": "alert-title", "parentId": "mot-ok", "content": "When it goes right" },
    { "id": "mot-ok-d", "type": "alert-description", "parentId": "mot-ok", "children": ["mot-ok-text"] },
    { "id": "mot-ok-text", "type": "citation-text", "parentId": "mot-ok-d", "meta": { "text": { "$bind": "props.moment_of_truth.success" } } },
    { "id": "mot-fail", "type": "alert", "parentId": "mot-grid", "meta": { "variant": "destructive" }, "children": ["mot-fail-t", "mot-fail-d"] },
    { "id": "mot-fail-t", "type": "alert-title", "parentId": "mot-fail", "content": "When it goes wrong" },
    { "id": "mot-fail-d", "type": "alert-description", "parentId": "mot-fail", "children": ["mot-fail-text"] },
    { "id": "mot-fail-text", "type": "citation-text", "parentId": "mot-fail-d", "meta": { "text": { "$bind": "props.moment_of_truth.failure" } } },
    { "id": "leave", "type": "alert", "parentId": "mot-grid", "meta": { "variant": "warning" }, "children": ["leave-t", "leave-d"] },
    { "id": "leave-t", "type": "alert-title", "parentId": "leave", "content": "Would leave if" },
    { "id": "leave-d", "type": "alert-description", "parentId": "leave", "children": ["leave-ul"] },
    { "id": "leave-ul", "type": "ul", "parentId": "leave-d", "children": ["leave-rep"] },
    { "id": "leave-rep", "type": "repeat", "parentId": "leave-ul", "meta": { "each": { "$bind": "props.would_leave_if" }, "as": "w" }, "children": ["leave-li"] },
    { "id": "leave-li", "type": "li", "parentId": "leave-rep", "children": ["leave-text"] },
    { "id": "leave-text", "type": "citation-text", "parentId": "leave-li", "meta": { "text": { "$bind": "w" } } },

    { "id": "stages", "type": "container", "parentId": "page", "meta": { "as": "section", "gap": "4" }, "children": ["st-h", "st-table"] },
    { "id": "st-h", "type": "h2", "parentId": "stages", "content": "Relationship with the service" },
    { "id": "st-table", "type": "table", "parentId": "stages", "children": ["st-head", "st-body"] },
    { "id": "st-head", "type": "table-header", "parentId": "st-table", "children": ["st-hr"] },
    { "id": "st-hr", "type": "table-row", "parentId": "st-head", "children": ["st-h1", "st-h2", "st-h3"] },
    { "id": "st-h1", "type": "table-head", "parentId": "st-hr", "content": "Stage" },
    { "id": "st-h2", "type": "table-head", "parentId": "st-hr", "content": "They do" },
    { "id": "st-h3", "type": "table-head", "parentId": "st-hr", "content": "The service provides" },
    { "id": "st-body", "type": "table-body", "parentId": "st-table", "children": ["st-rep"] },
    { "id": "st-rep", "type": "repeat", "parentId": "st-body", "meta": { "each": { "$bind": "props.relationship_stages" }, "as": "s" }, "children": ["st-row"] },
    { "id": "st-row", "type": "table-row", "parentId": "st-rep", "children": ["st-c1", "st-c2", "st-c3"] },
    { "id": "st-c1", "type": "table-cell", "parentId": "st-row", "content": { "$tpl": "{$n}. {s.stage}" } },
    { "id": "st-c2", "type": "table-cell", "parentId": "st-row", "children": ["st-do"] },
    { "id": "st-do", "type": "citation-text", "parentId": "st-c2", "meta": { "text": { "$bind": "s.they_do" } } },
    { "id": "st-c3", "type": "table-cell", "parentId": "st-row", "children": ["st-prov"] },
    { "id": "st-prov", "type": "citation-text", "parentId": "st-c3", "meta": { "text": { "$bind": "s.service_provides" } } },

    { "id": "quotes", "type": "container", "parentId": "page", "meta": { "as": "section", "gap": "4" }, "children": ["qt-h", "qt-grid"] },
    { "id": "qt-h", "type": "h2", "parentId": "quotes", "content": "In their words" },
    { "id": "qt-grid", "type": "grid", "parentId": "quotes", "meta": { "preset": "linear", "columns": 2, "gap": "4" }, "children": ["qt-rep"] },
    { "id": "qt-rep", "type": "repeat", "parentId": "qt-grid", "meta": { "each": { "$bind": "props.quotes" }, "as": "qt" }, "children": ["qt-block"] },
    { "id": "qt-block", "type": "blockquote", "parentId": "qt-rep", "children": ["qt-text"] },
    { "id": "qt-text", "type": "citation-text", "parentId": "qt-block", "meta": { "text": { "$bind": "qt" } } },

    { "id": "open", "type": "container", "parentId": "page", "meta": { "as": "section", "gap": "4", "$if": { "$bind": "props.open_questions" } }, "children": ["open-h", "open-rep"] },
    { "id": "open-h", "type": "h2", "parentId": "open", "content": "Still open" },
    { "id": "open-rep", "type": "repeat", "parentId": "open", "meta": { "each": { "$bind": "props.open_questions" }, "as": "o" }, "children": ["open-alert"] },
    { "id": "open-alert", "type": "alert", "parentId": "open-rep", "meta": { "variant": "info" }, "children": ["open-t", "open-d"] },
    { "id": "open-t", "type": "alert-title", "parentId": "open-alert", "content": { "$bind": "o.item" } },
    { "id": "open-d", "type": "alert-description", "parentId": "open-alert", "content": { "$bind": "o.question" } }
  ]
}
