[
  {
    "id": "commit-msg-heredoc-in-subst",
    "cmd": "git add src/a.rs && git commit -m \"$(cat <<'EOF'\nfix: don't trust the agent's \"quotes\" (it's a body)\nEOF\n)\" && git push origin HEAD",
    "expected": "visible",
    "managed": [
      [
        "git",
        "First"
      ],
      [
        "cat",
        "Substitution"
      ],
      [
        "git",
        "AfterOperator"
      ]
    ],
    "note": "two git invocations both AfterOperator (add is First, commit and push are AfterOperator); heredoc inside $() parses as literal text feeding cat, the apostrophe in the body does not break quoting"
  },
