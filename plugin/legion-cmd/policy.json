{
  "route": { "deadline_ms": 7000 },
  "sym_jobs": [
    {
      "id": "find-content",
      "sym_command": "legion sym etc find-content",
      "interpreter_patterns": ["rglob", "read_text"]
    },
    {
      "id": "find-file",
      "sym_command": "legion sym etc find-file",
      "interpreter_patterns": []
    },
    { "id": "script-walk-os-walk", "sym_command": "legion sym tree", "interpreter_patterns": ["os.walk"] },
    { "id": "script-walk-os-scandir", "sym_command": "legion sym tree", "interpreter_patterns": ["os.scandir"] },
    { "id": "script-walk-os-listdir", "sym_command": "legion sym tree", "interpreter_patterns": ["os.listdir"] },
    { "id": "script-walk-readdir", "sym_command": "legion sym tree", "interpreter_patterns": ["readdir"] },
    { "id": "script-walk-rglob", "sym_command": "legion sym tree", "interpreter_patterns": [".rglob("] },
    { "id": "script-walk-walkdir", "sym_command": "legion sym tree", "interpreter_patterns": ["walkdir"] },
    { "id": "script-glob-fnmatch", "sym_command": "legion sym etc find-file", "interpreter_patterns": ["fnmatch"] },
    { "id": "script-glob-glob", "sym_command": "legion sym etc find-file", "interpreter_patterns": ["glob.glob"] },
    { "id": "script-glob-path-glob", "sym_command": "legion sym etc find-file", "interpreter_patterns": [".glob("] },
    { "id": "script-grep-subprocess", "sym_command": "legion sym etc find-content", "interpreter_patterns": ["subprocess", "grep"] }
  ],
  "wrappers": [
    {
      "binary": "env",
      "flags": ["-", "-i", "--ignore-environment", "-0", "--null", "-v", "--debug"],
      "value_options": ["-u", "--unset", "-C", "--chdir", "-P"]
    },
    {
      "binary": "sudo",
      "flags": [
        "-A", "--askpass", "-b", "--background", "-B", "--bell", "-E", "--preserve-env",
        "-H", "--set-home", "-k", "--reset-timestamp", "-n", "--non-interactive",
        "-N", "--no-update", "-P", "--preserve-groups", "-S", "--stdin"
      ],
      "value_options": [
        "-u", "--user", "-g", "--group", "-C", "--close-from", "-D", "--chdir",
        "-p", "--prompt", "-R", "--chroot", "-r", "--role", "-t", "--type",
        "-T", "--command-timeout", "-U", "--other-user"
      ]
    },
    {
      "binary": "timeout",
      "flags": ["--foreground", "--preserve-status", "-v", "--verbose"],
      "value_options": ["-k", "--kill-after", "-s", "--signal"],
      "operands": 1
    },
    {
      "binary": "nice",
      "value_options": ["-n", "--adjustment"]
    },
    { "binary": "nohup" },
    {
      "binary": "stdbuf",
      "value_options": ["-i", "--input", "-o", "--output", "-e", "--error"]
    },
    {
      "binary": "xargs",
      "flags": [
        "-0", "--null", "-o", "--open-tty", "-p", "--interactive", "-r", "--no-run-if-empty",
        "-t", "--verbose", "-x", "--exit", "--show-limits"
      ],
      "value_options": [
        "-a", "--arg-file", "-d", "--delimiter", "-E", "-I", "-L", "-n", "--max-args",
        "-P", "--max-procs", "-s", "--max-chars", "--process-slot-var"
      ]
    },
    { "binary": "command", "flags": ["-p"] },
    { "binary": "exec", "flags": ["-c", "-l"], "value_options": ["-a"] },
    {
      "binary": "npx",
      "flags": ["-y", "--yes", "--workspaces", "--include-workspace-root"],
      "value_options": ["-p", "--package", "-w", "--workspace"]
    },
    { "binary": "pnpx", "flags": ["-s", "--silent"], "value_options": ["--package", "--allow-build", "--reporter"] },
    {
      "binary": "bunx",
      "flags": ["--bun", "--silent", "--verbose", "--no-install"],
      "value_options": ["-p", "--package"]
    },
    {
      "binary": "bun",
      "required_subcommand": "x",
      "flags": ["--bun", "--silent", "--verbose", "--no-install"],
      "value_options": ["-p", "--package"]
    },
    {
      "binary": "pnpm",
      "required_subcommand": "exec",
      "flags": ["-r", "--recursive", "--parallel", "--report-summary", "-w", "--workspace-root"],
      "value_options": ["--resume-from", "-C", "--dir", "-F", "--filter"]
    },
    {
      "binary": "pnpm",
      "required_subcommand": "dlx",
      "flags": ["-s", "--silent"],
      "value_options": ["--package", "--allow-build", "--reporter"]
    },
    {
      "binary": "npm",
      "required_subcommand": "exec",
      "flags": ["-y", "--yes", "--workspaces", "--include-workspace-root"],
      "value_options": ["-p", "--package", "-w", "--workspace", "--prefix"]
    },
    {
      "binary": "npm",
      "required_subcommand": "x",
      "flags": ["-y", "--yes", "--workspaces", "--include-workspace-root"],
      "value_options": ["-p", "--package", "-w", "--workspace", "--prefix"]
    },
    {
      "binary": "yarn",
      "required_subcommand": "exec",
      "flags": ["--silent", "--verbose"],
      "value_options": ["--cwd"],
      "selectors": ["workspace", "workspaces"]
    },
    {
      "binary": "yarn",
      "required_subcommand": "dlx",
      "flags": ["-q", "--quiet"],
      "value_options": ["-p", "--package"],
      "selectors": ["workspace", "workspaces"]
    }
  ],
  "interpreters": [
    { "binary": "sh", "flag": "-c", "body": "shell" },
    { "binary": "bash", "flag": "-c", "body": "shell" },
    { "binary": "python3", "flag": "-c", "body": "foreign" },
    { "binary": "python", "flag": "-c", "body": "foreign" },
    { "binary": "node", "flag": "-e", "body": "foreign" },
    { "binary": "ruby", "flag": "-e", "body": "foreign" },
    { "binary": "perl", "flag": "-e", "body": "foreign" }
  ],
  "script_carriers": [
    { "binary": "sh" },
    { "binary": "bash" },
    { "binary": "python3" },
    { "binary": "python" },
    { "binary": "node" },
    { "binary": "ruby" },
    { "binary": "perl" }
  ],
  "tools": {
    "Bash": {
      "families": {
        "grep": {
          "rules": [
            { "id": "grep-to-sym", "outcome": { "kind": "sym", "job": "find-content" } }
          ]
        },
        "rg": {
          "rules": [
            { "id": "rg-to-sym", "outcome": { "kind": "sym", "job": "find-content" } }
          ]
        },
        "egrep": { "rules": [{ "id": "egrep-to-sym", "outcome": { "kind": "sym", "job": "find-content" } }] },
        "fgrep": { "rules": [{ "id": "fgrep-to-sym", "outcome": { "kind": "sym", "job": "find-content" } }] },
        "ag": { "rules": [{ "id": "ag-to-sym", "outcome": { "kind": "sym", "job": "find-content" } }] },
        "ack": { "rules": [{ "id": "ack-to-sym", "outcome": { "kind": "sym", "job": "find-content" } }] },
        "git grep": { "rules": [{ "id": "git-grep-to-sym", "outcome": { "kind": "sym", "job": "find-content" } }] },
        "zgrep": { "rules": [{ "id": "zgrep-to-sym", "outcome": { "kind": "sym", "job": "find-content" } }] },
        "zegrep": { "rules": [{ "id": "zegrep-to-sym", "outcome": { "kind": "sym", "job": "find-content" } }] },
        "zfgrep": { "rules": [{ "id": "zfgrep-to-sym", "outcome": { "kind": "sym", "job": "find-content" } }] },
        "bzgrep": { "rules": [{ "id": "bzgrep-to-sym", "outcome": { "kind": "sym", "job": "find-content" } }] },
        "xzgrep": { "rules": [{ "id": "xzgrep-to-sym", "outcome": { "kind": "sym", "job": "find-content" } }] },
        "zstdgrep": { "rules": [{ "id": "zstdgrep-to-sym", "outcome": { "kind": "sym", "job": "find-content" } }] },
        "find": { "rules": [{ "id": "find-to-sym", "outcome": { "kind": "sym", "job": "find-file" } }] },
        "fd": { "rules": [{ "id": "fd-to-sym", "outcome": { "kind": "sym", "job": "find-file" } }] },
        "git ls-files": { "rules": [{ "id": "git-ls-files-to-sym", "outcome": { "kind": "sym", "job": "find-file" } }] },
        "ls": {
          "rules": [
            {
              "id": "ls-structure-note",
              "outcome": {
                "kind": "allow",
                "note": "if this listing is the shape of an indexed repo's code, `legion sym tree --repo <repo>` (directories and file layout) or `legion sym list --repo <repo>` (modules and their contents) answers it from the index. Your `ls` still runs -- not blocking you: `ls` shows what sym does not (metadata via `ls -l`, and non-source files like READMEs, configs and dotfiles)."
              }
            }
          ]
        },
        "sqlite3": {
          "rules": [
            {
              "id": "sqlite3-legion-db",
              "predicates": [{ "kind": "arg-present", "arg": "legion.db" }],
              "outcome": {
                "kind": "deny",
                "reason": "this command opens legion.db directly; the legion CLI is the sole API for legion state, and raw access bypasses migrations, constraints and the audit log",
                "instead": "the legion CLI (legion issue view, legion recall, legion bullpen, legion status, ...); file an issue for a CLI command or JSON flag if none exposes the field"
              }
            },
            { "id": "sqlite3-other-db", "outcome": { "kind": "allow" } }
          ]
        },
        "gh": {
          "rules": [
            {
              "id": "gh-unmapped",
              "outcome": {
                "kind": "deny",
                "reason": "work-source actions go through legion so they land in the audit log (`legion audit`), and this gh command has no direct legion equivalent",
                "instead": "legion --help"
              }
            }
          ]
        },
        "gh pr": {
          "rules": [
            {
              "id": "gh-pr-to-legion",
              "outcome": {
                "kind": "deny",
                "reason": "work-source actions go through legion so they land in the audit log (`legion audit`); this gh pr verb is not rewritten because its arguments carry free text or flags legion cannot round-trip",
                "instead": "legion pr --help (view, checks, comments, reviews, edit, review, merge and close; `legion comment` for comments, `legion pr create` to open)"
              }
            }
          ]
        },
        "gh issue": {
          "rules": [
            {
              "id": "gh-issue-to-legion",
              "outcome": {
                "kind": "deny",
                "reason": "work-source actions go through legion so they land in the audit log (`legion audit`); this gh issue verb is not rewritten because its arguments carry free text or flags legion cannot round-trip",
                "instead": "legion issue --help (view, list, create, close, reopen, edit; `legion comment` for comments)"
              }
            }
          ]
        },
        "gh run": {
          "rules": [
            {
              "id": "gh-run-to-pr-checks",
              "outcome": {
                "kind": "deny",
                "reason": "CI status lives on the PR in legion's model, not on the run",
                "instead": "legion pr checks --repo <repo> --number <n>"
              }
            }
          ]
        },
        "gh pr diff": {
          "rules": [
            {
              "id": "gh-pr-diff",
              "outcome": {
                "kind": "deny",
                "reason": "no legion command renders a PR's diff: legion pr view shows metadata and body only, so rewriting to it would hand back something other than what was asked",
                "instead": "legion pr view --repo <repo> --number <n> (metadata and body; no diff content)"
              }
            }
          ]
        },
        "gh pr view": {
          "rules": [
            {
              "id": "gh-pr-view-to-legion",
              "outcome": {
                "kind": "rewrite",
                "target": "legion pr view",
                "reason": "the audited work-source path: legion pr view lands in `legion audit` the way a raw gh call never does",
                "translatable": { "operands": ["integer"] }
              }
            }
          ]
        },
        "gh pr checks": {
          "rules": [
            {
              "id": "gh-pr-checks-to-legion",
              "outcome": {
                "kind": "rewrite",
                "target": "legion pr checks",
                "reason": "the audited work-source path: legion pr checks lands in `legion audit` the way a raw gh call never does",
                "translatable": { "operands": ["integer"] }
              }
            }
          ]
        },
        "gh pr list": {
          "rules": [
            {
              "id": "gh-pr-list-to-legion",
              "outcome": {
                "kind": "deny",
                "reason": "work-source actions go through legion so they land in the audit log (`legion audit`); this is not rewritten because the rewrite target cannot carry the required --repo until rewrites carry arguments (#1278)",
                "instead": "legion pr list --repo <repo>"
              }
            }
          ]
        },
        "gh issue view": {
          "rules": [
            {
              "id": "gh-issue-view-to-legion",
              "outcome": {
                "kind": "rewrite",
                "target": "legion issue view",
                "reason": "the audited work-source path: legion issue view lands in `legion audit` the way a raw gh call never does",
                "translatable": { "operands": ["integer"] }
              }
            }
          ]
        },
        "gh issue list": {
          "rules": [
            {
              "id": "gh-issue-list-to-legion",
              "outcome": {
                "kind": "deny",
                "reason": "work-source actions go through legion so they land in the audit log (`legion audit`); this is not rewritten because the rewrite target cannot carry the required --repo until rewrites carry arguments (#1278)",
                "instead": "legion issue list --repo <repo>"
              }
            }
          ]
        },
        "git push": {
          "rules": [
            {
              "id": "git-push-to-legion",
              "outcome": {
                "kind": "rewrite",
                "target": "legion push",
                "reason": "the audited push path (#791): legion push resolves the checkout that has the branch, refuses main/master, and writes an audit row carrying the branch, checkout and head SHA",
                "translatable": {
                  "flags": ["-u", "--set-upstream", "-q", "--quiet", "-v", "--verbose", "--progress"]
                }
              }
            }
          ]
        },
        "git commit": {
          "rules": [
            {
              "id": "git-commit-without-message",
              "predicates": [
                { "kind": "arg-absent", "arg": "-m" },
                { "kind": "arg-absent", "arg": "--message" },
                { "kind": "arg-absent", "arg": "-F" },
                { "kind": "arg-absent", "arg": "--file" }
              ],
              "outcome": {
                "kind": "deny",
                "reason": "a git commit with no -m/--message or -F/--file opens an editor, and legion commit needs an explicit message up front",
                "instead": "legion commit --repo <repo> --message '<type>(<scope>): <summary>' (or --message-file <path>)"
              }
            },
            {
              "id": "git-commit-to-legion",
              "outcome": {
                "kind": "rewrite",
                "target": "legion commit",
                "reason": "the audited commit path (#854): legion commit preflights the signer, refuses message-convention violations by name, and writes an audit row for every attempt",
                "translatable": {
                  "valued_flags": ["-m", "--message", "-F", "--file"]
                }
              }
            }
          ]
        },
        "rm": {
          "rules": [
            {
              "id": "rm-recursive-force",
              "predicates": [{ "kind": "arg-present", "arg": "-rf" }],
              "outcome": {
                "kind": "deny",
                "reason": "a combined recursive force delete is unrecoverable",
                "instead": "remove the specific paths, or use trash"
              }
            },
            {
              "id": "rm-other",
              "outcome": { "kind": "allow" }
            }
          ]
        },
        "curl": {
          "rules": [
            {
              "id": "curl-network",
              "outcome": {
                "kind": "ask",
                "question": "make this network request?",
                "reason": "curl reaches the network, which the agent should confirm",
                "needs_operator": true
              }
            }
          ]
        },
        "xxd": {
          "rules": [
            {
              "id": "xxd-verbatim",
              "outcome": { "kind": "proxy", "reason": "binary" }
            }
          ]
        }
      }
    },
    "Grep": {
      "rules": [
        { "id": "grep-tool-to-sym", "outcome": { "kind": "sym", "job": "find-content" } }
      ]
    },
    "Glob": {
      "rules": [
        { "id": "glob-tool-to-sym", "outcome": { "kind": "sym", "job": "find-file" } }
      ]
    },
    "Read": {
      "rules": [
        {
          "id": "read-source-unbounded",
          "predicates": [
            {
              "kind": "field-ends-with",
              "field": "file_path",
              "any_of": [".rs", ".ts", ".tsx", ".js", ".jsx", ".py", ".go", ".java", ".rb", ".php", ".c", ".cc", ".cpp", ".cxx", ".h", ".hpp", ".cs"]
            },
            { "kind": "field-absent", "field": "limit" }
          ],
          "outcome": {
            "kind": "deny",
            "reason": "an unbounded Read of a source file bills every line as cache_read, when one symbol's signature and docstring is usually the question",
            "instead": "legion sym hover <Symbol> (or legion sym def <Symbol>), or Read the file with limit=200"
          }
        },
        {
          "id": "read-source-oversized-limit",
          "predicates": [
            {
              "kind": "field-ends-with",
              "field": "file_path",
              "any_of": [".rs", ".ts", ".tsx", ".js", ".jsx", ".py", ".go", ".java", ".rb", ".php", ".c", ".cc", ".cpp", ".cxx", ".h", ".hpp", ".cs"]
            },
            { "kind": "field-greater-than", "field": "limit", "value": 500 }
          ],
          "outcome": {
            "kind": "deny",
            "reason": "a Read of a source file with a limit above 500 lines is unbounded for the cost argument: it bills every line as cache_read when one symbol's signature is usually the question",
            "instead": "legion sym hover <Symbol> (or legion sym def <Symbol>), or Read the file with limit=200"
          }
        }
      ]
    },
    "Write": {
      "rules": [
        {
          "id": "write-auto-memory",
          "predicates": [
            { "kind": "field-contains", "field": "file_path", "any_of": [".claude/projects/"] },
            { "kind": "field-contains", "field": "file_path", "any_of": ["/memory/"] }
          ],
          "outcome": {
            "kind": "deny",
            "reason": "this path is in the Claude Code auto-memory directory, which no other session, agent or repo can read; legion is the memory layer",
            "instead": "legion reflect --repo <repo> --text '<the note>' (project-wide guidance belongs in CLAUDE.md)"
          }
        },
        {
          "id": "write-script-tree",
          "predicates": [
            {
              "kind": "field-contains",
              "field": "content",
              "any_of": ["os.walk", "os.scandir", "os.listdir", "readdirSync", "fs.readdir", ".rglob(", "walkdir"]
            }
          ],
          "outcome": {
            "kind": "allow",
            "note": "that looks like a directory walk in a script you are writing; `legion sym tree --repo <repo>` returns it directly, with no file to write and no walk to run. Not blocking you: a script that walks a tree may also do real work, and if so carry on."
          }
        },
        {
          "id": "write-script-file",
          "predicates": [
            {
              "kind": "field-contains",
              "field": "content",
              "any_of": ["fnmatch", "glob.glob", ".glob(", ".endswith(", "path.match"]
            }
          ],
          "outcome": {
            "kind": "allow",
            "note": "that looks like a filename or glob match in a script you are writing; `legion sym etc find-file '<name-or-glob>' --repo <repo>` returns it directly. Not blocking you: if the match is incidental to real work, carry on."
          }
        },
        {
          "id": "write-script-content",
          "predicates": [
            {
              "kind": "field-contains",
              "field": "content",
              "any_of": ["re.search", "re.findall", "re.compile", ".includes("]
            }
          ],
          "outcome": {
            "kind": "allow",
            "note": "that looks like a text search inside files in a script you are writing; `legion sym etc find-content '<pattern>' --repo <repo>` returns it directly. Not blocking you: if the search is incidental to real work, carry on."
          }
        },
        {
          "id": "write-script-subprocess-grep",
          "predicates": [
            { "kind": "field-contains", "field": "content", "any_of": ["subprocess"] },
            { "kind": "field-contains", "field": "content", "any_of": ["grep"] }
          ],
          "outcome": {
            "kind": "allow",
            "note": "that looks like a grep shelled out from a script you are writing; `legion sym etc find-content '<pattern>' --repo <repo>` returns it directly. Not blocking you: if the search is incidental to real work, carry on."
          }
        }
      ]
    },
    "Edit": {
      "rules": [
        {
          "id": "edit-auto-memory",
          "predicates": [
            { "kind": "field-contains", "field": "file_path", "any_of": [".claude/projects/"] },
            { "kind": "field-contains", "field": "file_path", "any_of": ["/memory/"] }
          ],
          "outcome": {
            "kind": "deny",
            "reason": "this path is in the Claude Code auto-memory directory, which no other session, agent or repo can read; legion is the memory layer",
            "instead": "legion reflect --repo <repo> --text '<the note>' (project-wide guidance belongs in CLAUDE.md)"
          }
        },
        {
          "id": "edit-script-tree",
          "predicates": [
            {
              "kind": "field-contains",
              "field": "new_string",
              "any_of": ["os.walk", "os.scandir", "os.listdir", "readdirSync", "fs.readdir", ".rglob(", "walkdir"]
            }
          ],
          "outcome": {
            "kind": "allow",
            "note": "that looks like a directory walk in a script you are editing; `legion sym tree --repo <repo>` returns it directly, with no file to write and no walk to run. Not blocking you: a script that walks a tree may also do real work, and if so carry on."
          }
        },
        {
          "id": "edit-script-file",
          "predicates": [
            {
              "kind": "field-contains",
              "field": "new_string",
              "any_of": ["fnmatch", "glob.glob", ".glob(", ".endswith(", "path.match"]
            }
          ],
          "outcome": {
            "kind": "allow",
            "note": "that looks like a filename or glob match in a script you are editing; `legion sym etc find-file '<name-or-glob>' --repo <repo>` returns it directly. Not blocking you: if the match is incidental to real work, carry on."
          }
        },
        {
          "id": "edit-script-content",
          "predicates": [
            {
              "kind": "field-contains",
              "field": "new_string",
              "any_of": ["re.search", "re.findall", "re.compile", ".includes("]
            }
          ],
          "outcome": {
            "kind": "allow",
            "note": "that looks like a text search inside files in a script you are editing; `legion sym etc find-content '<pattern>' --repo <repo>` returns it directly. Not blocking you: if the search is incidental to real work, carry on."
          }
        },
        {
          "id": "edit-script-subprocess-grep",
          "predicates": [
            { "kind": "field-contains", "field": "new_string", "any_of": ["subprocess"] },
            { "kind": "field-contains", "field": "new_string", "any_of": ["grep"] }
          ],
          "outcome": {
            "kind": "allow",
            "note": "that looks like a grep shelled out from a script you are editing; `legion sym etc find-content '<pattern>' --repo <repo>` returns it directly. Not blocking you: if the search is incidental to real work, carry on."
          }
        }
      ]
    },
    "MultiEdit": {
      "rules": [
        {
          "id": "multiedit-auto-memory",
          "predicates": [
            { "kind": "field-contains", "field": "file_path", "any_of": [".claude/projects/"] },
            { "kind": "field-contains", "field": "file_path", "any_of": ["/memory/"] }
          ],
          "outcome": {
            "kind": "deny",
            "reason": "this path is in the Claude Code auto-memory directory, which no other session, agent or repo can read; legion is the memory layer",
            "instead": "legion reflect --repo <repo> --text '<the note>' (project-wide guidance belongs in CLAUDE.md)"
          }
        }
      ]
    },
    "Agent": {
      "rules": [
        {
          "id": "agent-untyped",
          "predicates": [{ "kind": "field-absent", "field": "subagent_type" }],
          "outcome": { "kind": "allow" }
        },
        {
          "id": "agent-explore-to-legion",
          "predicates": [
            { "kind": "field-equals", "field": "subagent_type", "any_of": ["explore"], "ignore_case": true }
          ],
          "outcome": {
            "kind": "rewrite",
            "target": "legion:legion-explore",
            "reason": "the built-in Explore agent greps and reads raw files; legion:legion-explore orients through sym and recall and returns conclusions with file:line evidence, so read its result as a cited answer rather than a listing"
          }
        }
      ]
    },
    "Task": {
      "rules": [
        {
          "id": "task-untyped",
          "predicates": [{ "kind": "field-absent", "field": "subagent_type" }],
          "outcome": { "kind": "allow" }
        },
        {
          "id": "task-explore-to-legion",
          "predicates": [
            { "kind": "field-equals", "field": "subagent_type", "any_of": ["explore"], "ignore_case": true }
          ],
          "outcome": {
            "kind": "rewrite",
            "target": "legion:legion-explore",
            "reason": "the built-in Explore agent greps and reads raw files; legion:legion-explore orients through sym and recall and returns conclusions with file:line evidence, so read its result as a cited answer rather than a listing"
          }
        }
      ]
    },
    "WebFetch": {
      "rules": [
        {
          "id": "webfetch-recall-first",
          "requires_recall": true,
          "outcome": {
            "kind": "allow",
            "note": "recall ran before this fetch: read its hits first, and skip the fetch if they already answer the question. Consider whether the reflection explains WHY before you search the web for WHAT."
          }
        }
      ]
    },
    "WebSearch": {
      "rules": [
        { "id": "websearch-recall-clamped", "outcome": { "kind": "allow" } }
      ]
    }
  }
}
